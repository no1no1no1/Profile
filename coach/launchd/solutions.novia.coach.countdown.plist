<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>solutions.novia.coach.countdown</string>
  <key>ProgramArguments</key>
  <array><string>/opt/homebrew/bin/node</string><string>__REPO__/coach/index.js</string><string>run</string><string>countdown</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StartInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>__HOME__/.coach/countdown.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.coach/countdown.log</string>
</dict>
</plist>
